# ── Required: Firebase Client SDK ─────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional: Firebase Extras ─────────────────────────────────
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ── Optional: Firebase Admin SDK (server-side, JSON string) ───
# FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}

# ── Optional: Sentry Error Reporting ──────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Optional: Client perf ingest (Web Vitals → POST /api/analytics/metrics) ──
# NEXT_PUBLIC_DISABLE_CLIENT_PERF_INGEST=true

# ── Optional: CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3031,https://your-app.web.app

# ── Optional: Rate Limiting (Upstash Redis) ───────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional: WebSocket ───────────────────────────────────────
# NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3032

# ── Optional: Firebase Emulators (dev only) ───────────────────
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# USE_FIREBASE_EMULATOR=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
